<!-- Unit tests, then integration tests against a real iTop (see test/integration/RealItop.php).
     Used by the nightly CI, where iTop is served at http://localhost; the credentials come from its environment. -->
<phpunit bootstrap="Support/bootstrap.php" backupGlobals="false" verbose="true">
  <php>
    <env name="ITOP_TEST_URL" value="http://localhost" force="false"/>
  </php>
  <testsuites>
    <testsuite name="testsU">
      <directory suffix="Test.php">.</directory>
      <exclude>php-code-style</exclude>
      <exclude>integration</exclude>
    </testsuite>
    <testsuite name="integration">
      <directory suffix="Test.php">integration</directory>
    </testsuite>
  </testsuites>
</phpunit>
